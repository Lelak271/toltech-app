<UserControl x:Class="Toltech.App.Views.Pages.DataPage.ToleranceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Toltech.App.Views.Pages.DataPage"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:localControls="clr-namespace:Toltech.App.FrontEnd.Controls" 
             xmlns:conv="clr-namespace:Toltech.App.Converters"
             xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
             xmlns:behaviors="clr-namespace:Toltech.App.Behaviors"
             Height="100" Width="605">

    <UserControl.Resources>

        <conv:IdToNameConverter  x:Key="IdToNameConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>


        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox} }" >
            <Setter Property="Background" Value="{DynamicResource PanelDataOffSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Active, RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Background" Value="{DynamicResource PanelDataSecondaryBrush }"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumEditTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumericTextBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelDataOffSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active, RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Background" Value="{DynamicResource PanelDataSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TolTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ToleranceTextBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelDataOffSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active, RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Background" Value="{DynamicResource PanelDataSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>



    </UserControl.Resources>


    <Border Margin="4"
            Padding="6"
            BorderThickness="1"
            CornerRadius="3">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ========================= -->
            <!-- Nom -->
            <!-- ========================= -->

            <TextBlock  Visibility="Collapsed" Grid.Row="0"
                    Grid.Column="0"
                    Foreground="Red"
                    FontWeight="Bold" Width="50"
                    FontSize="16"
                    Text="{Binding Active, RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" />
            
            <TextBox Visibility="Visible"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                behaviors:PlaceholderService.Placeholder="{Binding PlaceholderName,
                RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" />

            <!-- ========================= -->
            <!-- Colonne droite -->
            <!-- ========================= -->

            <StackPanel Grid.Row="0"
                        Grid.Column="1">

                <TextBox
                    Width="55"
                    HorizontalAlignment="Left"
                    IsReadOnly="True"
                    Cursor="No"
                    Text="{Binding Id}" />

                <CheckBox
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    IsChecked="{Binding UseDatabase}">

                    <Image Source="/Asset/Logo_DB_tol.png"
                           Height="22"/>

                </CheckBox>

            </StackPanel>

            <!-- ========================= -->
            <!-- Description -->
            <!-- ========================= -->

            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,4,5,0"
                TextWrapping="Wrap"
                Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                behaviors:PlaceholderService.Placeholder="{Binding PlaceholderDescription,
        RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" />

            <!-- ========================= -->
            <!-- Tolérance -->
            <!-- ========================= -->

            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,0">

                <!--<TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding Header}" />-->

                <TextBox
                    Margin="0,2,0,0"
                    Style="{StaticResource TolTextBoxStyle}"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PlaceholderService.Placeholder="{Binding PlaceholderTolerance,
        RelativeSource={RelativeSource AncestorType=local:ToleranceEditor}}" />


                

            </StackPanel>

        </Grid>

    </Border>


</UserControl>