<Window x:Class="Toltech.App.Views.CadTransformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Toltech.App.Views.Pages.V3D"
        xmlns:obj="clr-namespace:Toltech.App.Utilities.Object3D"
        mc:Ignorable="d"
        Title="CadTransformWindow" Height="800" Width="380"
        Topmost="True">

    <Window.Resources>

    </Window.Resources>

    <Grid>
        <Border x:Name="CadTransformPanel"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="0"
                CornerRadius="0"
                Panel.ZIndex="20" 
                Style="{DynamicResource BorderThemeStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                   Opacity="0.20"
                                   BlurRadius="18"
                                   ShadowDepth="2" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" >
                <StackPanel Margin="12,14,12,16">

                    <TextBlock Text="Transformation" 
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,10" />

                    <!-- Groupe Position -->
                    <Border >
                        <StackPanel>
                            <TextBlock Text="Position"  />
                            <UniformGrid Columns="3" Rows="1">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Tx"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.TranslationX, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Text="Ty"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.TranslationY, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Tz"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.TranslationZ, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Rotation -->
                    <Border >
                        <StackPanel>
                            <TextBlock Text="Rotation"  />
                            <UniformGrid Columns="3" Rows="1">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Rx"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.RotationX, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Text="Ry"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.RotationY, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Rz"  />
                                    <TextBox 
                                             Text="{Binding SelectedCadObject.Transform.RotationZ, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Échelle (uniforme sur les 3 axes) -->
                    <Border >
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Échelle" 
                                           Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Réinitialiser"
                                        
                                        Command="{Binding ResetSelectedTransformCommand}" />
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="Facteur (X = Y = Z)"  />
                                <TextBox 
                                         Text="{Binding SelectedCadObject.Transform.Scale, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CadToolInstruction}"
                               Foreground="#6B7280"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10" />

                    <!-- Groupe Objets CAO -->
                    <Border >
                        <StackPanel>
                            <TextBlock Text="Objets importés"  />

                            <TreeView x:Name="CadObjectsTree"
                                      ItemsSource="{Binding CadObjects}"
                                      SelectedItemChanged="CadObjectsTree_SelectedItemChanged"
                                      MaxHeight="220"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="False"
                                      >
                                <TreeView.Resources>
                                    <!-- Permet au TreeViewItem de donner toute sa largeur au contenu -->
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                    
                                    <HierarchicalDataTemplate DataType="{x:Type obj:CadObject}" ItemsSource="{Binding Children}">
                                        <Grid Margin="0,2,0,2" HorizontalAlignment="Left" ShowGridLines="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="25"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                    Command="{Binding DataContext.CadObjectVisibilityCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button
                                                    Grid.Column="1"
                                                    Width="16"
                                                    Height="16"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Changer la couleur"
                                                    Command="{Binding DataContext.ChangeSelectedCadColorCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Ellipse
                                                                Width="10"
                                                                Height="10"
                                                                Stroke="#D1D5DB"
                                                                StrokeThickness="0.75">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="{Binding Color}" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding Name}"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        TextTrimming="CharacterEllipsis" />

                                            <Button       Command="{Binding DataContext.ClearSelectCadObjectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                            Grid.Column="3"
                                                            Content="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Margin="4,0,0,0" />

                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>

                            <Button Content="Changer la couleur"
                                    
                                    Command="{Binding ChangeSelectedCadColorCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>