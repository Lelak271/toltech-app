<UserControl
    x:Class="Toltech.App.Views.Pages.V3D.ToolTip_Vector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Toltech.App.Converters"
    xmlns:lang="clr-namespace:Toltech.App.Resources.Lang"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <conv:IdToNameConverter x:Key="IdToNameConverter"/>
        <conv:LinkageTypeLocalizationConverter x:Key="LinkageTypeLocalizationConverter"/>
    </UserControl.Resources>

    <Border
    MaxWidth="360"
    HorizontalAlignment="Left"
    Padding="14"
    Background="#FAFAFA"
    BorderBrush="#DCDCDC"
    BorderThickness="1"
    CornerRadius="6">

        <Border.Effect>
            <DropShadowEffect
            BlurRadius="12"
            ShadowDepth="3"
            Opacity="0.18"/>
        </Border.Effect>

        <StackPanel
        HorizontalAlignment="Left">

            <!-- ================================================= -->
            <!-- En-tête                                           -->
            <!-- ================================================= -->

            <TextBlock
            Text="{Binding Name}"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="#232323"
            HorizontalAlignment="Left"
            TextAlignment="Left"
            Margin="0,0,0,10"/>

            <!-- Séparateur -->

            <Border
            Height="1"
            HorizontalAlignment="Stretch"
            Background="#E1E1E1"
            Margin="0,0,0,10"/>



            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="Liaison : "
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                            Grid.Column="1"
                            Foreground="#232323"
                            FontSize="12"
                            FontWeight="Medium"
                            HorizontalAlignment="Left"
                            TextAlignment="Left">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LinkageTypeLocalizationConverter}">
                            <Binding Path="Linkage" />
                            <Binding Path="CurrentCulture" Source="{x:Static lang:LocalizationManager.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

            </Grid>

            
            <!-- ================================================= -->
            <!-- Identification                                    -->
            <!-- ================================================= -->

            <TextBlock
            Text="IDENTIFICATION"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6E6E6E"
            HorizontalAlignment="Left"
            TextAlignment="Left"
            Margin="0,5,0,4"/>


            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="ID"
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                Grid.Column="1"
                Text="{Binding Id}"
                Foreground="#232323"
                FontSize="12"
                FontWeight="Medium"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

            </Grid>


            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="Pièce 1"
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                Grid.Column="1"
                Text="{Binding Part1Id,
                    Converter={StaticResource IdToNameConverter}}"
                Foreground="#232323"
                FontSize="12"
                FontWeight="Medium"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

            </Grid>


            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="Pièce 2"
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                Grid.Column="1"
                Text="{Binding Part2Id,
                    Converter={StaticResource IdToNameConverter}}"
                Foreground="#232323"
                FontSize="12"
                FontWeight="Medium"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

            </Grid>


            <!-- ================================================= -->
            <!-- Geometry                                           -->
            <!-- ================================================= -->

            <TextBlock
            Text="POINT"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6E6E6E"
            HorizontalAlignment="Left"
            TextAlignment="Left"
            Margin="0,10,0,4"/>


            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="Position"
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                Grid.Column="1"
                Text="{Binding Position}"
                Foreground="#232323"
                FontSize="12"
                FontWeight="Medium"
                HorizontalAlignment="Left"
                TextAlignment="Left"
                TextWrapping="Wrap"/>

            </Grid>


            <!-- ================================================= -->
            <!-- Direction                                         -->
            <!-- ================================================= -->

            <TextBlock
            Text="DIRECTION"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6E6E6E"
            HorizontalAlignment="Left"
            TextAlignment="Left"
            Margin="0,10,0,4"/>


            <Grid
            HorizontalAlignment="Stretch"
            Margin="0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Text="Vecteur"
                Foreground="#646464"
                FontSize="12"
                HorizontalAlignment="Left"
                TextAlignment="Left"/>

                <TextBlock
                Grid.Column="1"
                Text="{Binding Direction}"
                Foreground="#232323"
                FontSize="12"
                FontWeight="Medium"
                HorizontalAlignment="Left"
                TextAlignment="Left"
                TextWrapping="Wrap"/>

            </Grid>
        </StackPanel>

    </Border>

</UserControl>